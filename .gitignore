# Ignore existing workspace artifacts by default.
/*

# Keep source and packaging files.
!/.gitignore
!/README.md
!/pyproject.toml
!/svgflow/
/svgflow/*
!/svgflow/__init__.py
!/svgflow/canvas.py
!/svgflow/external_figures.py
!/svgflow/inkscape_fonts.py
!/svgflow/text_metrics.py
!/tests/
!/tests/*.py

# Never track generated packaging output or Python caches.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
pypi-svgflow-token.txt